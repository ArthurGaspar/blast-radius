{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "sqlite" },
  "ConnectionStrings": { "Default": "Data Source=blast-radius.db" },
  "Jwt": {
    "Secret": "local-development-secret-change-me-0123456789",
    "Issuer": "blast-radius",
    "Hours": 12
  },
  "Sources": {
    "NvdApiKey": "",
    "GithubToken": ""
  },
  "Ingestion": { "Scheduled": true, "IntervalHours": 6, "ManualCooldownMinutes": 10 },
  "Webhooks": { "AllowPrivateTargets": false, "TimeoutSeconds": 5 },
  "Cors": { "Origins": [ "http://localhost:5173" ] }
}
