{
  "about": "Run against the ASP.NET Core API (BlastRadius.Tests/ContractTests.cs) and the browser engine (web/src/engine/contract.test.ts). A step with 'fixtures' switches the recorded source data. JSON paths: $.a.b, [n], trailing # for length. Expected values may be {gt|gte|lt|contains: x}.",
  "steps": [
    { "name": "register an analyst", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "alex", "displayName": "Alex", "password": "correct-horse-1" },
      "expect": { "status": 201, "json": { "$.user.username": "alex" } }, "save": { "token:alex": "$.token" } },
    { "name": "register a second account", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "blair", "displayName": "Blair", "password": "correct-horse-2" },
      "expect": { "status": 201 }, "save": { "token:blair": "$.token" } },
    { "name": "short passwords are refused", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "casey", "displayName": "Casey", "password": "short" },
      "expect": { "status": 400, "code": "validation" } },
    { "name": "usernames are unique regardless of case", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "ALEX", "displayName": "Other", "password": "correct-horse-3" },
      "expect": { "status": 409, "code": "auth.username-taken" } },
    { "name": "wrong password", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "alex", "password": "nope-nope-nope" },
      "expect": { "status": 401, "code": "auth.bad-credentials" } },
    { "name": "no token, no data", "method": "GET", "path": "/api/exposure", "expect": { "status": 401 } },
    { "name": "the catalog is public", "method": "GET", "path": "/api/catalog",
      "expect": { "status": 200, "json": { "$.products#": 15, "$.sitePresets#": 74 } } },

    { "name": "a site from a preset", "as": "alex", "method": "POST", "path": "/api/sites",
      "body": { "name": "São Paulo office", "kind": "office", "presetKey": "sao-paulo" },
      "expect": { "status": 201, "json": { "$.lat": -23.55, "$.lon": -46.63 } }, "save": { "office": "$.id" } },
    { "name": "a site by coordinates", "as": "alex", "method": "POST", "path": "/api/sites",
      "body": { "name": "GPU cluster", "kind": "cloud", "lat": 39.04, "lon": -77.49 },
      "expect": { "status": 201 }, "save": { "cluster": "$.id" } },
    { "name": "a site needs a location", "as": "alex", "method": "POST", "path": "/api/sites",
      "body": { "name": "Nowhere", "kind": "office" }, "expect": { "status": 400, "code": "validation" } },
    { "name": "Ollama 0.1.30 at the office", "as": "alex", "method": "POST", "path": "/api/assets",
      "body": { "siteId": "{office}", "productKey": "ollama", "version": "0.1.30" },
      "expect": { "status": 201, "json": { "$.label": "Ollama", "$.affected": 0 } }, "save": { "ollama": "$.id" } },
    { "name": "Ray with an unknown version on the cluster", "as": "alex", "method": "POST", "path": "/api/assets",
      "body": { "siteId": "{cluster}", "productKey": "ray", "label": "Ray head node" },
      "expect": { "status": 201 }, "save": { "rayUnknown": "$.id" } },
    { "name": "Ray 2.53.0 at the office", "as": "alex", "method": "POST", "path": "/api/assets",
      "body": { "siteId": "{office}", "productKey": "ray", "version": "2.53.0", "label": "Ray notebooks" },
      "expect": { "status": 201 }, "save": { "rayPinned": "$.id" } },
    { "name": "unknown products are refused", "as": "alex", "method": "POST", "path": "/api/assets",
      "body": { "siteId": "{office}", "productKey": "skynet", "version": "1.0" },
      "expect": { "status": 400, "code": "validation" } },
    { "name": "other accounts can't touch Alex's sites", "as": "blair", "method": "PUT", "path": "/api/sites/{office}",
      "body": { "name": "Mine now", "kind": "office", "presetKey": "london" }, "expect": { "status": 404 } },
    { "name": "nor put assets on them", "as": "blair", "method": "POST", "path": "/api/assets",
      "body": { "siteId": "{office}", "productKey": "ollama", "version": "0.1.30" }, "expect": { "status": 400 } },

    { "name": "subscribe to anything high or worse", "as": "alex", "method": "POST", "path": "/api/subscriptions",
      "body": { "name": "High and up", "scope": "all", "minSeverity": "high" },
      "expect": { "status": 201 }, "save": { "subAll": "$.id" } },
    { "name": "subscribe to exploited vulnerabilities on the cluster", "as": "alex", "method": "POST", "path": "/api/subscriptions",
      "body": { "name": "Cluster: exploited", "scope": "site", "scopeSiteId": "{cluster}", "minSeverity": "low", "kevOnly": true },
      "expect": { "status": 201 }, "save": { "subKev": "$.id" } },
    { "name": "webhooks can't target this machine (SSRF)", "as": "alex", "method": "POST", "path": "/api/subscriptions",
      "body": { "name": "Sneaky", "scope": "all", "minSeverity": "low", "webhookUrl": "https://127.0.0.1/admin" },
      "expect": { "status": 422, "code": "webhook.rejected" } },
    { "name": "nor cloud metadata", "as": "alex", "method": "POST", "path": "/api/subscriptions",
      "body": { "name": "Sneaky", "scope": "all", "minSeverity": "low", "webhookUrl": "https://169.254.169.254/latest" },
      "expect": { "status": 422, "code": "webhook.rejected" } },

    { "fixtures": "day1" },
    { "name": "ingest day 1", "as": "alex", "method": "POST", "path": "/api/ingestion/run?wait=true",
      "expect": { "status": 200, "json": { "$.created": { "gt": 30 }, "$.errors#": 0, "$.notifications": { "gt": 0 } } } },
    { "name": "GitHub's id resolves to the CVE record, with NVD's score", "as": "alex", "method": "GET",
      "path": "/api/vulnerabilities/GHSA-8hqg-whrw-pv92",
      "expect": { "status": 200, "json": { "$.id": "CVE-2024-37032", "$.redirected": true, "$.sources#": 2,
                                            "$.cvss": 8.8, "$.cvssSource": "nvd", "$.severity": "high", "$.title": { "contains": "Ollama" } } } },
    { "name": "Ollama 0.1.30 is affected, fixed in 0.1.34", "as": "alex", "method": "GET", "path": "/api/vulnerabilities/CVE-2024-37032",
      "expect": { "status": 200, "json": { "$.matches#": 1, "$.matches[0].status": "affected", "$.matches[0].label": "Ollama",
                                            "$.matches[0].fixedIn": "0.1.34", "$.matches[0].level": "severe" } } },
    { "name": "a withdrawn advisory reaches nothing", "as": "alex", "method": "GET", "path": "/api/vulnerabilities/GHSA-xg2h-7cxj-3gvh",
      "expect": { "status": 200, "json": { "$.withdrawn": true, "$.matches#": 0 } } },
    { "name": "a GitHub advisory without a CVE keeps its GHSA id", "as": "alex", "method": "GET", "path": "/api/vulnerabilities/GHSA-hhrp-gw25-jr43",
      "expect": { "status": 200, "json": { "$.id": "GHSA-hhrp-gw25-jr43", "$.sources#": 1, "$.matches#": 2 } } },
    { "name": "the office is severe; the cluster's Ray version is unknown", "as": "alex", "method": "GET", "path": "/api/exposure",
      "expect": { "status": 200, "json": { "$.sites#": 2, "$.sites[0].level": "severe", "$.sites[1].level": "elevated",
                                            "$.sites[1].possible": { "gt": 0 }, "$.sites[1].affected": 0, "$.totals.kev": 0 } } },
    { "name": "exposure became notifications", "as": "alex", "method": "GET", "path": "/api/notifications",
      "expect": { "status": 200, "json": { "$.unread": { "gt": 0 }, "$.items[0].reason": "new_exposure" } } },
    { "name": "nothing on the cluster is known to be exploited yet", "as": "alex", "method": "GET", "path": "/api/subscriptions/{subKev}/preview",
      "expect": { "status": 200, "json": { "$.matches": 0 } } },
    { "name": "the same data again changes nothing", "as": "alex", "method": "POST", "path": "/api/ingestion/run?wait=true",
      "expect": { "status": 200, "json": { "$.created": 0, "$.merged": 0, "$.notifications": 0 } } },

    { "fixtures": "day2" },
    { "name": "ingest day 2: Ray's CVE-2025-62593 enters KEV, GHSA-hhrp gets its CVE", "as": "alex", "method": "POST",
      "path": "/api/ingestion/run?wait=true",
      "expect": { "status": 200, "json": { "$.merged": { "gte": 1 }, "$.kevMarked": { "gte": 1 }, "$.notifications": 2 } } },
    { "name": "the GitHub-only record was re-keyed and merged with NVD's", "as": "alex", "method": "GET",
      "path": "/api/vulnerabilities/GHSA-hhrp-gw25-jr43",
      "expect": { "status": 200, "json": { "$.id": "CVE-2026-57516", "$.redirected": true, "$.sources#": 2, "$.matches#": 2 } } },
    { "name": "KEV details are attached", "as": "alex", "method": "GET", "path": "/api/vulnerabilities/CVE-2025-62593",
      "expect": { "status": 200, "json": { "$.kev.added": "2026-08-17", "$.matches#": 1, "$.matches[0].status": "possible" } } },
    { "name": "both subscriptions heard about the exploitation, once each", "as": "alex", "method": "GET", "path": "/api/notifications?unread=true&size=2",
      "expect": { "status": 200, "json": { "$.items[0].reason": "kev_added", "$.items[1].reason": "kev_added",
                                            "$.items[0].vulnerabilityId": "CVE-2025-62593" } } },
    { "name": "the cluster subscription now has something", "as": "alex", "method": "GET", "path": "/api/subscriptions/{subKev}/preview",
      "expect": { "status": 200, "json": { "$.matches": 1, "$.sample[0].id": "CVE-2025-62593" } } },
    { "name": "mark everything read", "as": "alex", "method": "POST", "path": "/api/notifications/read-all",
      "expect": { "status": 200, "json": { "$.marked": { "gt": 2 } } } },
    { "name": "inbox is clear", "as": "alex", "method": "GET", "path": "/api/notifications?unread=true",
      "expect": { "status": 200, "json": { "$.unread": 0, "$.items#": 0 } } },
    { "name": "exposure counts the exploited vulnerability", "as": "alex", "method": "GET", "path": "/api/exposure",
      "expect": { "status": 200, "json": { "$.totals.kev": 1 } } },
    { "name": "exposure scoped to the cluster lists only its asset", "as": "alex", "method": "GET", "path": "/api/exposure?site={cluster}",
      "expect": { "status": 200, "json": { "$.sites#": 2, "$.threats[0].assets#": 1, "$.threats[0].assets[0].label": "Ray head node" } } },

    { "name": "upgrading Ollama to 0.1.34 clears that CVE", "as": "alex", "method": "PUT", "path": "/api/assets/{ollama}",
      "body": { "siteId": "{office}", "productKey": "ollama", "version": "0.1.34" }, "expect": { "status": 200 } },
    { "name": "CVE-2024-37032 no longer reaches anything", "as": "alex", "method": "GET", "path": "/api/vulnerabilities/CVE-2024-37032",
      "expect": { "status": 200, "json": { "$.matches#": 0 } } },
    { "name": "search by alias and filter by product", "as": "alex", "method": "GET", "path": "/api/vulnerabilities?q=GHSA-8hqg-whrw-pv92",
      "expect": { "status": 200, "json": { "$.total": 1, "$.items[0].id": "CVE-2024-37032" } } },
    { "name": "only exploited Ray vulnerabilities", "as": "alex", "method": "GET", "path": "/api/vulnerabilities?product=ray&kev=true",
      "expect": { "status": 200, "json": { "$.total": 1, "$.items[0].id": "CVE-2025-62593" } } },
    { "name": "a site with scoped subscriptions can't vanish", "as": "alex", "method": "DELETE", "path": "/api/sites/{cluster}",
      "expect": { "status": 409, "code": "site.has-subscriptions" } },
    { "name": "Blair sees none of it", "as": "blair", "method": "GET", "path": "/api/notifications",
      "expect": { "status": 200, "json": { "$.total": 0 } } },
    { "name": "the ingestion log shows both sources", "as": "alex", "method": "GET", "path": "/api/ingestion/status",
      "expect": { "status": 200, "json": { "$.totals.both": { "gt": 10 }, "$.totals.nvdOnly": { "gt": 0 }, "$.totals.ghsaOnly": { "gt": 0 },
                                            "$.totals.kev": 1, "$.totals.withdrawn": 1 } } }
  ]
}
